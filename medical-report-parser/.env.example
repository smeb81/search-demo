# 环境变量配置
# 复制此文件为 .env 并填入实际值

# Anthropic API 配置（必需）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Base URL（可选，使用默认的 https://api.anthropic.com）
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Claude 模型（可选，默认 claude-sonnet-4-6）
# ANTHROPIC_MODEL=claude-sonnet-4-6

# 服务端口（可选，默认 8081）
# SERVER_PORT=8081
